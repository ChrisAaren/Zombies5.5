{
  "_doc": "Fixed stress poses. World axes: character faces -Y, its left is +X, up is +Z. Ops are applied in order about each bone head, on top of the poses of its parents. aim = swing the bone so it points along a world direction. flex = rotate the bone `deg` degrees about cross(bone_dir, toward), i.e. toward that direction. rot = rotate `deg` degrees about a world axis. Ops with sides + mirror_x are written for Left and mirrored (x -> -x) for Right.",
  "poses": [
    {"id": "arms_raised", "label": "ARMS RAISED", "view": "front", "ops": [
      {"bone": "{S}UpperArm", "aim": [0.2, 0.0, 1.0], "sides": ["Left", "Right"], "mirror_x": true}]},
    {"id": "arms_forward", "label": "ARMS FORWARD", "view": "side", "ops": [
      {"bone": "{S}UpperArm", "aim": [0.12, -1.0, 0.0], "sides": ["Left", "Right"], "mirror_x": true}]},
    {"id": "elbows_bent_140", "label": "ELBOWS 140", "view": "side", "ops": [
      {"bone": "{S}LowerArm", "flex": {"toward": [0.0, -1.0, 0.0], "deg": 140}, "sides": ["Left", "Right"], "mirror_x": true}]},
    {"id": "squat", "label": "SQUAT 100", "view": "side", "ops": [
      {"bone": "{S}UpperLeg", "flex": {"toward": [0.0, -1.0, 0.0], "deg": 100}, "sides": ["Left", "Right"], "mirror_x": true},
      {"bone": "{S}LowerLeg", "flex": {"toward": [0.0, 0.0, -1.0], "deg": 100}, "sides": ["Left", "Right"], "mirror_x": true}]},
    {"id": "torso_twist_45", "label": "TWIST 45", "view": "front", "ops": [
      {"bone": "Spine", "rot": {"axis": [0, 0, 1], "deg": 20}},
