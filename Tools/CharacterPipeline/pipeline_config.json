{
  "_doc": "Shared settings for the character pipeline. Iterations change this file (a copy is stored in every vNNN folder as config_used.json), not the code.",
  "tier": "player",
  "tiers": {
    "player": {
      "lod0_tris": 25000,
      "tris_min": 20000,
      "tris_max": 30000,
      "texture_size": 2048
    },
    "story_npc": {
      "lod0_tris": 15000,
      "tris_min": 10000,
      "tris_max": 20000,
      "texture_size": 2048
    },
    "pedestrian": {
      "lod0_tris": 7500,
      "tris_min": 5000,
      "tris_max": 10000,
      "texture_size": 1024
    }
  },
  "lod_ratios": [
    1.0,
    0.5,
    0.2
  ],
  "lod_ratio_tolerance": 0.1,
  "cleanup": {
    "target_height_m": 1.8,
    "height_range_m": [
      1.7,
      1.9
    ],
    "auto_face": true,
    "source_yaw_deg": 0,
    "proxy_voxel_size": 0.004,
    "proxy_shell_thickness": 0.006,
    "proxy_shell_offset": -1.0,
    "proxy_max_tris": 90000,
    "proxy_smooth_iterations": 0,
    "bake_samples": 4,
    "bake_margin_px": 12,
    "bake_cage_extrusion": 0.02,
    "bake_max_ray_distance": 0.05,
    "uv_island_margin": 0.004,
    "hidden_body": {
      "_doc": "Remove body-skin faces fully covered by clothing from the GAME mesh/LODs (proxy keeps them). Materials matched by name substring: body_materials = skin; garment_materials = cloth that counts as cover. A body face goes if 1+cone_rays rays (normal + cone) all hit a garment within max_cover_distance_m, unless it lies within opening_band_m of a garment boundary edge (cuff/collar/hem/ankle).",
      "enabled": true,
      "body_materials": [
        "Skin"
      ],
      "garment_materials": [
        "Top",
        "Pants",
        "Shoes"
      ],
      "max_cover_distance_m": 0.04,
      "cone_angle_deg": 25,
      "cone_rays": 6,
      "opening_band_m": 0.03
    }
  },
  "joints": {
    "slice_step_m": 0.01,
    "min_confidence": 0.4,
    "snap_limb_joints_to_narrowest": false,
    "hand_slice_fractions": [
      0.35,
      0.45,
      0.55,
      0.65,
      0.75
    ]
  },
  "skin": {
    "max_influences": 4,
    "clean_below": 0.01,
    "smooth_passes": 3,
    "smooth_factor": 0.5,
    "smooth_groups": [
      "Hips",
      "Spine",
      "Chest",
      "Neck",
      "Head",
      "Shoulder",
      "UpperArm",
      "LowerArm",
      "UpperLeg",
      "LowerLeg"
    ],
    "repair_far_weights": false,
    "hand_cleanup": true,
    "hand_cleanup_fraction": 0.25,
    "hem_fix": {
      "radius_m": 0.1,
      "from_bone": "Spine",
      "to_bone": "Hips",
      "fraction": 1.0
    },
    "lods_skip_resmooth": true
  },
  "check": {
    "far_bone_fraction_of_height": 0.15,
    "weight_sum_tolerance": 0.001,
    "mirror_tolerance_m": 0.002,
    "max_volume_loss_pct": 12.0,
    "max_volume_gain_pct": 15.0,
    "max_edge_stretch_ratio": 3.0,
    "max_holes_game": 0,
    "stress_poses_lods": [
      0,
      1,
      2
    ],
    "tile_px": 512,
    "max_new_boundary_loops": 0,
    "non_manifold_slack": 0,
    "max_hand_leak_verts": 0,
    "max_finger_cross_bleed_ratio": 0.05,
    "max_self_intersections_per_1k_tris": 10,
    "min_edge_len_m": 0.005,
    "lod_limits": {
      "_doc": "Per-LOD overrides of the check limits (key = LOD index). A key missing here falls back to the top-level check value. Volume and weight limits are global.",
      "0": {
        "max_edge_stretch_ratio": 3.0,
        "max_self_intersections_per_1k_tris": 10
      },
      "1": {
        "max_edge_stretch_ratio": 3.0,
        "max_self_intersections_per_1k_tris": 10
      },
      "2": {
        "max_edge_stretch_ratio": 4.5,
        "max_self_intersections_per_1k_tris": 25
      }
    }
  }
}